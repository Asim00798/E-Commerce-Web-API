{
  "Cors": {
    "AllowedOrigins": [
      "https://app.company.com",
      "https://admin.company.com"
    ],
    "AllowCredentials": true
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:5001"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "ApiSettings": {
    "ApiKey": "Prod-API-Key-From-Environment-Variables",
    "Secret": "Production-Secret-Key-Must-Be-Stored-In-Key-Vault"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=prod-server;Database=ECommerce_Prod;User Id=prod-user;Password=prod-password;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ecommerce-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  }
}
