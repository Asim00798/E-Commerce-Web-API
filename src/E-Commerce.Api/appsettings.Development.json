{
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "https://localhost:5173"
    ],
    "AllowCredentials": true
  },

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:5001"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ecommerce-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": false,
          "flushToDiskInterval": "00:00:01"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "Swagger": {
    "Title": "E-Commerce API",
    "Version": "v1",
    "Description": "E-Commerce Modular Monolith API",
    "ContactName": "API Team",
    "ContactEmail": "api@ecommerce.local"
  },

  "Versioning": {
    "DefaultMajorVersion": 1,
    "DefaultMinorVersion": 0
  },

  "RateLimiting": {
    "Ip": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "User": {
      "PermitLimit": 50,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    },
    "Global": {
      "PermitLimit": 500,
      "QueueLimit": 50
    }
  },

  "App": {
    "Name": "E-Commerce.Api",
    "Version": "1.0.0"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ECommerce_Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}