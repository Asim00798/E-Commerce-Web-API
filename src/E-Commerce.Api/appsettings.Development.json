{
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "https://localhost:60449"
    ],
    "AllowCredentials": true
  },

  "Redis": {
    "Configuration": "localhost:6379"
  },

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:60449"
      }
    }
  },

  "Proxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "ForwardedHeaders": [ "XForwardedFor", "XForwardedProto" ],
    "KnownProxies": [],
    "KnownNetworks": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ecommerce-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": false,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "Swagger": {
    "Title": "E-Commerce API",
    "Version": "v1",
    "Description": "E-Commerce Modular Monolith API",
    "ContactName": "API Team",
    "ContactEmail": "api@ecommerce.local"
  },

  "Versioning": {
    "DefaultMajorVersion": 1,
    "DefaultMinorVersion": 0
  },

  "RateLimiting": {
    "Ip": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "User": {
      "PermitLimit": 50,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4,
      "QueueLimit": 0
    },
    "Global": {
      "PermitLimit": 500,
      "QueueLimit": 50
    }
  },

  "App": {
    "Name": "E-Commerce.Api",
    "Version": "1.0.0"
  },

  "Database": {
    "Migrations": {
      "Enabled": true,
      "RetryCount": 3,
      "RetryDelaySeconds": 5
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=E-Commerce;User Id=sa;Password=123456;TrustServerCertificate=True;"
  },

  "ReadModel": {
    "MigrationConnectionString": "Server=.;Database=E-Commerce;User Id=sa;Password=123456;TrustServerCertificate=True;"
  }
}